{
  "info": {
    "_postman_id": "b3e94a82-1234-4567-89ab-taskmanagerapi",
    "name": "Task Manager API",
    "description": "Collection for testing Task Manager API endpoints built with NestJS & Prisma (SQLite)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Task (POST /tasks)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('taskId', jsonData.id);",
              "    console.log('Saved taskId:', jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Complete Full-Stack Assignment\",\n  \"description\": \"Build NestJS backend with SQLite & Next.js frontend\",\n  \"status\": \"IN_PROGRESS\",\n  \"dueDate\": \"2026-11-25T18:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Creates a new task. The created task ID is automatically saved to the collection variable `taskId`."
      },
      "response": []
    },
    {
      "name": "2. Get All Tasks (GET /tasks)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Retrieve all tasks ordered by createdAt descending."
      },
      "response": []
    },
    {
      "name": "3. Get Single Task by ID (GET /tasks/:id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Fetch a specific task by its ID."
      },
      "response": []
    },
    {
      "name": "4. Update Task (PATCH /tasks/:id)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DONE\",\n  \"description\": \"Assignment completed and tested with Postman!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Updates fields of an existing task."
      },
      "response": []
    },
    {
      "name": "5. Delete Task (DELETE /tasks/:id)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Deletes a task by ID. Returns 204 No Content."
      },
      "response": []
    },
    {
      "name": "6. Test Validation Error (POST /tasks with empty body)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INVALID_STATUS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Demonstrates class-validator and NestJS ValidationPipe returning 400 Bad Request with field errors."
      },
      "response": []
    }
  ]
}
